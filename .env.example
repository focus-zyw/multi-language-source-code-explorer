# 可选：省略时也使用此本地 SQLite 文件，不需要数据库服务
DATABASE_URL=file:./data/code-atlas.db

# 可选：手动运行可信本地项目已有测试，默认关闭；启用后仍须在页面逐次确认
# 测试执行没有只读沙箱，可能写文件、访问网络或数据库；不适用于不可信源码
# CODE_ATLAS_TEST_EXECUTION=true

# 可选：启用 AI 讲解（只在服务端读取，不会暴露给浏览器）
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai   # 或 anthropic

# 可选：讲解默认来源 api | agent；省略时优先使用已配置的 API，否则使用本机 Agent
# AI_EXPLAIN_BACKEND=agent
# 本机 Agent 当前支持 Codex，自动查找 PATH、npm 安装和 Windows 桌面版
# AI_AGENT_ENABLED=false       # 禁用自动检测
# AI_AGENT_COMMAND=C:/path/to/codex.exe  # 可选：CLI 可执行文件的绝对路径
# AI_AGENT_MODEL=              # 可选：省略时使用 Codex 默认模型
# AI_AGENT_TIMEOUT_MS=300000   # 1000–600000 毫秒
